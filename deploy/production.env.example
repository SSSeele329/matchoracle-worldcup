# MatchOracle production environment template.
# This file is intentionally not ready to source as-is.
# Fill every blank or placeholder before using it in a real deployment.

MATCHORACLE_APP_ENV=production

# Required secret. Leave blank in the template so readiness stays BLOCKED until configured.
MATCHORACLE_WORKER_TOKEN=

# Required runtime flags.
MATCHORACLE_WORKER_RUNTIME_CONFIGURED=0

# Required persistent stores. Replace with deployment-specific durable paths or database URLs.
MATCHORACLE_SNAPSHOT_STORE=
MATCHORACLE_JOB_QUEUE_STORE=
MATCHORACLE_ODDS_STORE=
MATCHORACLE_STRUCTURED_FACTS_STORE=

# Required structured facts provider contract.
# Must not be mock, disabled, csv, manual, csv_manual, or csv_manual_fallback in production.
MATCHORACLE_STRUCTURED_FACTS_PROVIDER=
MATCHORACLE_STRUCTURED_FACTS_PROVIDER_CONFIGURED=0
MATCHORACLE_STRUCTURED_FACTS_API_BASE_URL=
MATCHORACLE_STRUCTURED_FACTS_PROVIDER_TOKEN=

# AI stays evidence-only. It must never generate official facts such as odds, scores,
# standings, cards, or official lineups.
MATCHORACLE_AI_EVIDENCE_PROVIDER=disabled
MATCHORACLE_AI_EVIDENCE_POLICY=EVIDENCE_EXTRACTION_ONLY
MATCHORACLE_AI_ALLOW_FACT_GENERATION=0

# Reviewed fallback path. This does not replace the structured facts provider.
MATCHORACLE_CSV_FALLBACK_ENABLED=1

# Optional real odds provider credentials.
# CSV/manual fallback can stay enabled, but production market automation should use a provider token.
MATCHORACLE_ODDS_API_BASE_URL=
MATCHORACLE_ODDS_PROVIDER_TOKEN=

# Optional commercial layer placeholders. Leave blank until subscription work starts.
MATCHORACLE_PAYMENT_PROVIDER=
MATCHORACLE_PAYMENT_PROVIDER_SECRET=

# Deployment-agnostic operations declarations.
MATCHORACLE_JOB_FAILURE_ALERTS_CONFIGURED=0
MATCHORACLE_STALE_JOB_MONITOR_CONFIGURED=0
MATCHORACLE_QUEUE_BACKLOG_MONITOR_CONFIGURED=0
MATCHORACLE_STORE_BACKUP_POLICY_CONFIGURED=0
MATCHORACLE_STORE_MIGRATION_POLICY_CONFIGURED=0

# Optional odds import hardening.
MATCHORACLE_ODDS_IMPORT_PATH_ROOT=data/odds

# Optional worker tuning.
MATCHORACLE_WORKER_CONCURRENCY=1
MATCHORACLE_JOB_LEASE_TIMEOUT_SECONDS=300
