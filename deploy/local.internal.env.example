# MatchOracle local internal test board environment.
# Copy to deploy/local.internal.env and fill secrets locally.
# Do not commit the copied file.

MATCHORACLE_APP_ENV=development
MATCHORACLE_REQUIRE_WORKER_TOKEN=0
MATCHORACLE_WORKER_TOKEN=
MATCHORACLE_WORKER_RUNTIME_CONFIGURED=1

MATCHORACLE_SNAPSHOT_STORE=data/worldcup/local_prediction_snapshots.sqlite3
MATCHORACLE_JOB_QUEUE_STORE=data/worldcup/local_background_jobs.sqlite3
MATCHORACLE_ODDS_STORE=data/worldcup/local_market_odds.sqlite3
MATCHORACLE_STRUCTURED_FACTS_STORE=data/worldcup/local_structured_facts.sqlite3

MATCHORACLE_STRUCTURED_FACTS_PROVIDER=football_data_org
MATCHORACLE_STRUCTURED_FACTS_PROVIDER_CONFIGURED=1
MATCHORACLE_STRUCTURED_FACTS_API_BASE_URL=https://api.football-data.org/v4
MATCHORACLE_STRUCTURED_FACTS_PROVIDER_TOKEN=

MATCHORACLE_AI_EVIDENCE_PROVIDER=disabled
MATCHORACLE_AI_EVIDENCE_POLICY=EVIDENCE_EXTRACTION_ONLY
MATCHORACLE_AI_ALLOW_FACT_GENERATION=0
MATCHORACLE_CSV_FALLBACK_ENABLED=1

MATCHORACLE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
MATCHORACLE_ODDS_PROVIDER_TOKEN=

MATCHORACLE_JOB_FAILURE_ALERTS_CONFIGURED=1
MATCHORACLE_STALE_JOB_MONITOR_CONFIGURED=1
MATCHORACLE_QUEUE_BACKLOG_MONITOR_CONFIGURED=1
MATCHORACLE_STORE_BACKUP_POLICY_CONFIGURED=1
MATCHORACLE_STORE_MIGRATION_POLICY_CONFIGURED=1

MATCHORACLE_ODDS_IMPORT_PATH_ROOT=data/odds
MATCHORACLE_WORKER_CONCURRENCY=1
MATCHORACLE_JOB_LEASE_TIMEOUT_SECONDS=300
